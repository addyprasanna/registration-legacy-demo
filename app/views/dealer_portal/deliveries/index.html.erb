<% content_for :title, "Pending registrations" %>
<section class="mb-12"><p class="eyebrow">Dealer portal</p><h1 class="display mt-3">Pending registrations</h1><p class="lede mt-4">Delivered and scheduled vehicles without a submitted or approved registration.</p></section>
<div class="card overflow-x-auto"><% if @deliveries.any? %><table class="table"><thead><tr><th>Customer</th><th>Vehicle</th><th>Delivery center</th><th>Scheduled</th><th>Days since delivery</th><th>Actions</th></tr></thead><tbody>
  <% @deliveries.each do |delivery| %><tr><td><%= delivery.vehicle.customer.display_name %></td><td><%= link_to delivery.vehicle.vin, vehicle_path(delivery.vehicle), class: "text-ink-100 hover:text-champagne" %></td><td><%= delivery.delivery_center %></td><td><%= format_date(delivery.scheduled_on) %></td><td><%= [(Date.current - delivery.scheduled_on).to_i, 0].max %></td><td class="whitespace-nowrap"><%= link_to "Start registration", new_registration_path(vehicle_id: delivery.vehicle_id), class: "btn-link" %> · <%= link_to "Issue temp tag", new_temp_tag_path(vehicle_id: delivery.vehicle_id), class: "btn-link" %></td></tr><% end %>
</tbody></table><% else %><p class="muted py-10 text-center text-sm">No records.</p><% end %></div>
