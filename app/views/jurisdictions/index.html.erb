<% content_for :title, "Jurisdictions" %>
<section class="mb-12"><p class="eyebrow">Service network</p><h1 class="display mt-3">Jurisdictions</h1><p class="lede mt-4">Fee parameters and service capabilities across 50 states, the District of Columbia, and Canadian provinces.</p></section>
<div class="card overflow-x-auto"><table class="table"><thead><tr><th>Jurisdiction</th><th>Code</th><th>Tier</th><th>Country</th><th>Currency</th><th class="num">EV surcharge</th><th>Temp tag</th><th>ELT</th></tr></thead><tbody>
  <% @jurisdictions.each do |jurisdiction| %><tr><td><%= link_to jurisdiction.display_name, jurisdiction_path(jurisdiction.code), class: "text-ink-100 hover:text-champagne" %></td><td><%= jurisdiction.code %></td><td><%= jurisdiction.tier %></td><td><%= jurisdiction.country %></td><td><%= jurisdiction.currency %></td><td class="num"><% ev = jurisdiction.const_defined?(:EV_SURCHARGE_CENTS) ? jurisdiction.const_get(:EV_SURCHARGE_CENTS).to_i : 0 %><%= ev.positive? ? format_money(ev, jurisdiction.currency) : content_tag(:span, "None", class: "text-ink-500") %></td><td><%= jurisdiction.const_get(:TEMP_TAG_DAYS) %> days</td><td><%= jurisdiction.elt_available? ? "Available" : "Paper" %></td></tr><% end %>
</tbody></table></div>
