<% content_for :title, "Temporary tags" %>
<section class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">Temporary operating permits</p><h1 class="display mt-3">Temporary tags</h1><p class="lede mt-4">Issue tags and monitor upcoming expirations.</p></div><div class="flex gap-3"><%= link_to "Issue temp tag", new_temp_tag_path, class: "btn-primary" %></div></section>
<%= form_with url: temp_tags_path, method: :get, class: "mb-6 flex gap-3" do |form| %><label class="flex items-center gap-3 text-sm text-ink-300"><%= form.check_box :expiring_soon, { checked: params[:expiring_soon].present?, class: "checkbox" }, "1", "" %>Expiring within 7 days</label><%= form.submit "Apply", class: "btn-secondary" %><% end %>
<div class="card overflow-x-auto"><% if @temp_tags.any? %><table class="table"><thead><tr><th>Tag</th><th>Customer</th><th>Vehicle</th><th>Jurisdiction</th><th>Issued</th><th>Expires</th><th>Status</th></tr></thead><tbody>
  <% @temp_tags.each do |tag| %><tr><td><%= link_to tag.tag_number, temp_tag_path(tag), class: "text-ink-100 hover:text-champagne" %></td><td><%= tag.vehicle.customer.display_name %></td><td><%= tag.vehicle.vin %></td><td><%= tag.jurisdiction_code %></td><td><%= format_date(tag.issued_on) %></td><td><%= format_date(tag.expires_on) %></td><td><%= status_badge(tag.status) %></td></tr><% end %>
</tbody></table><% else %><p class="muted py-10 text-center text-sm">No records.</p><% end %></div>
