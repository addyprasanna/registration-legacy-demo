<% content_for :title, "Issue temp tag" %>
<section class="mb-12"><p class="eyebrow">Temporary operating permits</p><h1 class="display mt-3">Issue temporary tag</h1><p class="lede mt-4">Select a vehicle and issue date for a new temporary tag.</p></section>
<% if @vehicle_error.present? %><p class="field-error mb-6"><%= @vehicle_error %></p><% end %>
<%= form_with url: temp_tags_path, method: :post, class: "card" do |form| %><div class="card-body"><div class="grid gap-6 md:grid-cols-2">
  <div><%= form.label :vehicle_id, "Vehicle", class: "label" %><%= form.select :vehicle_id, options_from_collection_for_select(@vehicles, :id, ->(v) { "#{v.vin} · #{v.customer.display_name} · #{v.jurisdiction_code}" }, params[:vehicle_id]), { prompt: "Select a vehicle" }, class: "select" %></div>
  <div><%= form.label :issue_date, "Issue date", class: "label" %><%= form.date_field :issue_date, value: Date.current, class: "input" %></div>
  <div><%= form.label :buyer_jurisdiction, "Buyer jurisdiction (optional)", class: "label" %><%= form.select :buyer_jurisdiction, options_for_select([["Use vehicle jurisdiction", ""]] + Jurisdictions.codes.sort.map { |c| [c, c] }), {}, class: "select" %></div>
</div><div class="mt-8 flex gap-3"><%= form.submit "Issue tag", class: "btn-primary" %><%= link_to "Cancel", temp_tags_path, class: "btn-secondary" %></div></div><% end %>
