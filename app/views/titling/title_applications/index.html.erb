<% content_for :title, "Title applications" %>
<section class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">Titling operations</p><h1 class="display mt-3">Title applications</h1><p class="lede mt-4">Track applications from draft through issuance.</p></div><div class="flex gap-3"><%= link_to "New application", new_title_application_path, class: "btn-primary" %></div></section>
<div class="card overflow-x-auto"><% if @title_applications.any? %><table class="table"><thead><tr><th>Application</th><th>Customer</th><th>Vehicle</th><th>Jurisdiction</th><th>Status</th><th>Created</th></tr></thead><tbody>
  <% @title_applications.each do |application| %><tr><td><%= link_to application.application_number, title_application_path(application), class: "text-ink-100 hover:text-champagne" %></td><td><%= application.vehicle.customer.display_name %></td><td><%= application.vehicle.vin %></td><td><%= application.jurisdiction_code %></td><td><%= status_badge(application.status) %></td><td><%= format_date(application.created_at.to_date) %></td></tr><% end %>
</tbody></table><% else %><p class="muted py-10 text-center text-sm">No records.</p><% end %></div>
