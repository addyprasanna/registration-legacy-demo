<% content_for :title, "New title application" %>
<section class="mb-12"><p class="eyebrow">Titling operations</p><h1 class="display mt-3">New title application</h1><p class="lede mt-4">Create an application for a registered vehicle.</p></section>
<%= form_with url: title_applications_path, method: :post, class: "card" do |form| %><div class="card-body"><div class="max-w-2xl"><%= form.label :vehicle_id, "Vehicle", class: "label" %><%= form.select :vehicle_id, options_from_collection_for_select(@vehicles, :id, ->(v) { "#{v.vin} · #{v.customer.display_name} · #{v.jurisdiction_code}" }), { prompt: "Select a vehicle" }, class: "select" %></div><div class="mt-8 flex gap-3"><%= form.submit "Create application", class: "btn-primary" %><%= link_to "Cancel", title_applications_path, class: "btn-secondary" %></div></div><% end %>
