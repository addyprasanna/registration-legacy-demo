<% content_for :title, "Registrations" %>
<section class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">Registration operations</p><h1 class="display mt-3">Vehicle registrations</h1><p class="lede mt-4">Calculate jurisdiction fees and submit registration records.</p></div><div class="flex gap-3"><%= link_to "New registration", new_registration_path, class: "btn-primary" %></div></section>
<%= form_with url: registrations_path, method: :get, class: "mb-6 flex flex-col gap-3 sm:flex-row" do |form| %><%= form.select :status, options_for_select([["All statuses", ""]] + Registrations::Registration::STATUSES.map { |s| [s.humanize, s] }, params[:status]), {}, class: "select sm:max-w-xs" %><%= form.select :jurisdiction, options_for_select([["All jurisdictions", ""]] + Jurisdictions.codes.sort.map { |c| [c, c] }, params[:jurisdiction]), {}, class: "select sm:max-w-xs" %><%= form.submit "Apply", class: "btn-secondary" %><% end %>
<div class="card overflow-x-auto"><% if @registrations.any? %><table class="table"><thead><tr><th>Customer</th><th>Vehicle</th><th>Jurisdiction</th><th>Status</th><th>Created</th><th class="num">Total</th></tr></thead><tbody>
  <% @registrations.each do |registration| %><tr><td><%= registration.vehicle.customer.display_name %></td><td><%= link_to registration.vehicle.vin, registration_path(registration), class: "text-ink-100 hover:text-champagne" %></td><td><%= registration.jurisdiction_code %></td><td><%= status_badge(registration.status) %></td><td><%= format_date(registration.created_at.to_date) %></td><td class="num"><%= format_money(registration.total_cents, registration.currency) %></td></tr><% end %>
</tbody></table><% else %><p class="muted py-10 text-center text-sm">No records.</p><% end %></div>
