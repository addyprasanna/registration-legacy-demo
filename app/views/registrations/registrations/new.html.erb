<% content_for :title, "New registration" %>
<section class="mb-12"><p class="eyebrow">Registration operations</p><h1 class="display mt-3">New registration</h1><p class="lede mt-4">Choose a vehicle to calculate a jurisdiction-specific fee quote.</p></section>
<% if @vehicle_error.present? %><p class="field-error mb-6"><%= @vehicle_error %></p><% end %>
<%= form_with url: registrations_path, method: :post, class: "card" do |form| %><div class="card-body"><div class="max-w-2xl"><%= form.label :vehicle_id, "Vehicle", class: "label" %><%= form.select :vehicle_id, options_from_collection_for_select(@vehicles, :id, ->(vehicle) { "#{vehicle.vin} · #{vehicle.model} · #{vehicle.customer.display_name} · #{vehicle.jurisdiction_code}" }, params[:vehicle_id]), { prompt: "Select a vehicle" }, class: "select" %></div><div class="mt-8 flex gap-3"><%= form.submit "Calculate quote", class: "btn-primary" %><%= link_to "Cancel", registrations_path, class: "btn-secondary" %></div></div><% end %>
