<% content_for :title, "Lien filings" %>
<section class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">Secured interests</p><h1 class="display mt-3">Lien filings</h1><p class="lede mt-4">Determine lien requirements and track filing status.</p></div><div class="flex gap-3"><%= link_to "New determination", new_lien_filing_path, class: "btn-primary" %></div></section>
<div class="card overflow-x-auto"><% if @lien_filings.any? %><table class="table"><thead><tr><th>Customer</th><th>Vehicle</th><th>Jurisdiction</th><th>Financing</th><th>Method</th><th>Required</th><th>Status</th></tr></thead><tbody>
  <% @lien_filings.each do |filing| %><tr><td><%= filing.vehicle.customer.display_name %></td><td><%= link_to filing.vehicle.vin, lien_filing_path(filing), class: "text-ink-100 hover:text-champagne" %></td><td><%= filing.jurisdiction_code %></td><td><%= filing.financing.humanize %></td><td><%= filing.filing_method&.humanize || "—" %></td><td><%= filing.required? ? "Yes" : "No" %></td><td><%= status_badge(filing.status) %></td></tr><% end %>
</tbody></table><% else %><p class="muted py-10 text-center text-sm">No records.</p><% end %></div>
